# Valgrind suppressions for running the pg_query specs under Ruby (Task 09,
# tier 2 / the `memcheck-ruby` CI job).
#
# IMPORTANT: tier 2 is INFORMATIONAL. The CRuby interpreter is conservatively
# garbage-collected and holds large allocations for the process lifetime, so
# Valgrind reports thousands of "definitely lost" blocks and uninitialised-value
# errors that all originate inside the `ruby` binary / libruby, NOT in pg_query.
# We verified (see bin/run_memcheck.sh, tier 1) that the native rewrite path is
# leak- and error-free on its own; tier 2 only adds confidence that the binding
# does not leak across the Ruby boundary. These suppressions cut the bulk of the
# interpreter noise so the log is readable, but they are not exhaustive and the
# job is not expected to exit zero -- it is run with continue-on-error.
#
# To regenerate/extend: the CI job passes --gen-suppressions=all, which prints a
# ready-to-paste stanza for every unsuppressed finding.

# --- Leaks attributed to the interpreter binary / libruby ---------------------
{
   ruby-binary-lifetime-leaks
   Memcheck:Leak
   match-leak-kinds: definite,indirect,possible,reachable
   ...
   obj:*/bin/ruby
}

{
   ruby-libruby-lifetime-leaks
   Memcheck:Leak
   match-leak-kinds: definite,indirect,possible,reachable
   ...
   obj:*/libruby*
}

{
   ruby-dl-lifetime-leaks
   Memcheck:Leak
   match-leak-kinds: definite,indirect,possible,reachable
   ...
   obj:*/ld-*.so
}

# --- Conservative-GC stack scan: uninitialised-value / invalid-read noise -----
{
   ruby-gc-scan-cond
   Memcheck:Cond
   ...
   obj:*/bin/ruby
}

{
   ruby-gc-scan-value8
   Memcheck:Value8
   ...
   obj:*/bin/ruby
}

{
   ruby-gc-scan-addr
   Memcheck:Addr8
   ...
   obj:*/bin/ruby
}

{
   ruby-libruby-cond
   Memcheck:Cond
   ...
   obj:*/libruby*
}
